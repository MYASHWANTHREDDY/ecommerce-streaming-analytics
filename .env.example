# Kafka
KAFKA_BOOTSTRAP=localhost:29092
# Container-internal address (Spark, and later Airflow, run inside the compose network)
KAFKA_BOOTSTRAP_INTERNAL=kafka:9092
KAFKA_TOPIC_ORDERS=orders
KAFKA_TOPIC_DLQ=orders_dlq

# Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8081
# Container-internal address (Spark runs inside the compose network)
SCHEMA_REGISTRY_URL_INTERNAL=http://schema-registry:8081

# Producer
RATE=100
CORRUPT_PCT=0.02
DATA_FILE=data/sample_1k.csv
LOOP=true

# Postgres
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=analytics
# Container-internal pair (unusually the bare names here) — used by Spark/Airflow, which
# run inside the compose network.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-facing pair — for processes that run on the host (dashboard, pytest suite, psql),
# not inside the compose network.
POSTGRES_HOST_EXTERNAL=localhost
POSTGRES_PORT_EXTERNAL=5433

# Airflow
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__UNIT_TEST_MODE=False
# Dev-only secret, used to sign webserver sessions. Generate your own with:
# python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW__WEBSERVER__SECRET_KEY=21814f76e2bc9953a40ea6918ea1c3ea

# GCP BigQuery export (airflow/dags/export_to_bigquery.py) — see CHANGELOG.md item 5
# for the one-time `gcloud` setup that creates the project/bucket/dataset/key.
# Fill these in and drop the downloaded service-account key at secrets/gcp-key.json
# (gitignored, mounted read-only into the Airflow containers).
GCP_PROJECT_ID=your-gcp-project-id
GCP_GCS_BUCKET=your-gcs-bucket-name
GCP_BQ_DATASET=ecommerce_marts

# Hosted dashboard (scripts/sync_to_cloud_demo.py) — see docs/hosting-setup.md for the
# one-time Neon/Supabase + Streamlit Community Cloud setup. Only needed to run the sync
# script locally; the hosted dashboard itself gets its own copy of this via Streamlit's
# secrets.toml, not this file.
CLOUD_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
